{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/nascimento-jean/MK-Viral-Assembly/blob/main/nextflow_schema.json",
  "title": "MK-Viral-Assembly parameters",
  "description": "Parameters for reference-based viral genome assembly from Illumina reads.",
  "type": "object",
  "definitions": {
    "input_output": {
      "title": "Input and output",
      "type": "object",
      "properties": {
        "input": {"type": "string", "format": "path", "description": "Samplesheet CSV or folder containing paired FASTQ files."},
        "reference": {"type": ["string", "null"], "format": "file-path", "description": "Global reference FASTA. Per-sample references can be provided in the samplesheet."},
        "gff": {"type": ["string", "null"], "format": "file-path", "description": "Optional GFF3 annotation."},
        "primer_bed": {"type": ["string", "null"], "format": "file-path", "description": "Optional primer BED file."},
        "metadata": {"type": ["string", "null"], "format": "file-path", "description": "Optional XLSX, CSV or TSV metadata table."},
        "outdir": {"type": "string", "format": "directory-path", "default": "results"}
      },
      "required": ["input"]
    },
    "calling": {
      "title": "Read trimming, consensus and variants",
      "type": "object",
      "properties": {
        "trim_min_len": {"type": "integer", "minimum": 1, "default": 30, "description": "Minimum read length retained after iVar primer trimming."},
        "min_cov": {"type": "integer", "minimum": 1, "default": 20, "description": "Minimum depth required to call a consensus base."},
        "consensus_min_freq": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.75, "description": "Minimum allele frequency for the consensus."},
        "variant_min_freq": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.25, "description": "Minimum allele frequency reported in variant TSV and VCF outputs."},
        "min_qual": {"type": "integer", "minimum": 0, "default": 20},
        "min_map_qual": {"type": "integer", "minimum": 0, "default": 20},
        "amplicon_min_breadth": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.9, "description": "Minimum fraction of an amplicon at min_cov before it is flagged as a dropout."}
      }
    },
    "sample_classification": {
      "title": "Sample classification",
      "type": "object",
      "properties": {
        "negative_control_prefix": {"type": "string", "default": "CN", "description": "Legacy fallback prefix. Prefer the samplesheet sample_type column."}
      }
    },
    "optional_analysis": {
      "title": "Optional analyses",
      "type": "object",
      "properties": {
        "nextclade": {"type": "boolean", "default": true},
        "nextclade_dataset": {"type": ["string", "null"]},
        "blast_id": {"type": "boolean", "default": false},
        "kraken2_db": {"type": ["string", "null"], "format": "directory-path"},
        "deplete_host": {"type": "boolean", "default": false}
      }
    },
    "resources": {
      "title": "Resources",
      "type": "object",
      "properties": {
        "max_cpus": {"type": "integer", "minimum": 1, "default": 14},
        "max_memory": {"type": "string", "default": "50.GB"},
        "max_time": {"type": "string", "default": "72.h"}
      }
    }
  },
  "allOf": [
    {"$ref": "#/definitions/input_output"},
    {"$ref": "#/definitions/calling"},
    {"$ref": "#/definitions/sample_classification"},
    {"$ref": "#/definitions/optional_analysis"},
    {"$ref": "#/definitions/resources"}
  ]
}
